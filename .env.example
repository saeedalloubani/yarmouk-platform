# =============================================================================
# Yarmouk Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit secrets.

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# Project URL and anon (public) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — server-only. NEVER expose to the browser. Bypasses RLS.
# Used by /api/public/* endpoints to act on behalf of anonymous respondents
# after validating their invitation token.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
RESEND_API_KEY=

# -----------------------------------------------------------------------------
# Encryption
# -----------------------------------------------------------------------------
# pgcrypto column encryption key for PII fields (recipient_name_encrypted,
# recipient_email_encrypted, signed_name_encrypted, etc.). 32-byte base64.
# Generate: openssl rand -base64 32
# In production this is held in Supabase Vault, NOT in env.
ENCRYPTION_KEY=

# Backup file encryption passphrase — a SEPARATE secret from ENCRYPTION_KEY.
# Used to encrypt/decrypt .yarmoukbackup archives. If lost, backups are
# unrecoverable. Document this somewhere safe (password manager / paper).
BACKUP_PASSPHRASE=

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Only required if Whisper auto-transcription is enabled. See STATUS Session 6
# open question — may not be needed if manual transcript paste-in is chosen.
OPENAI_API_KEY=

# Public site URL — used in invitation emails and outbound links.
# Local dev: http://localhost:3000
# Production: https://karasneh-research.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000
